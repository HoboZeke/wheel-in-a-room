  canaryFocusCameraPos: {x: -1.9175583, y: 1.6193262, z: 3.9865608}
  canaryFocueCameraRot: {x: 13.098956, y: 327.51642, z: 0.014028382}
  cameraFocusPoint: {fileID: 6105159537129137216}
