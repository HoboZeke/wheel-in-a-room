  canaryChoiceDesc: {fileID: 0}
  canaryChoiceInstruction: {fileID: 0}
  canaryChoiceA: {fileID: 0}
  canaryChoiceB: {fileID: 0}
  canaryChoiceC: {fileID: 0}
  choiceATitle: {fileID: 0}
  choiceBTitle: {fileID: 0}
  choiceCTitle: {fileID: 0}
  choiceADesc: {fileID: 0}
  choiceBDesc: {fileID: 0}
  choiceCDesc: {fileID: 0}
  trinkA: {fileID: 0}
  trinkB: {fileID: 0}
  trinkC: {fileID: 0}
  choiceTitles:
  - A Lucky Charm?
  choiceDescriptions:
  - I wasn't using it anyway.
  choiceInstructions:
  - (You can only take one)
  tutorialBeats:
  - cameraPos: {x: -1.9175583, y: 0, z: 3.9865608}
    cameraFocalPos: {x: -2.4910002, y: 1.3642299, z: 4.8}
    autoComplete: 0
    storyText: 'Taking on the gambit are you?

      Well let me walk you through
      a few things.'
  - cameraPos: {x: -2.2904303, y: 0, z: 2.419641}
    cameraFocalPos: {x: -0.024068236, y: 1.47, z: 4.75947}
    autoComplete: 0
    storyText: 'First off is the Wheel, pull the lever over there to spin it.

      The
      wheels your main way to get Fuel and Coins, and you''re going to want both.'
  - cameraPos: {x: 1.0984473, y: 0, z: 1.8385863}
    cameraFocalPos: {x: 4.97, y: 1.35, z: -0.7962903}
    autoComplete: 0
    storyText: 'You can spend your coins at the shop to change the wheel.

      The
      lever on the left will scoop up all your coins for you.'
  - cameraPos: {x: 0.9821617, y: 0, z: -1.5006341}
    cameraFocalPos: {x: -4.71, y: 0.99, z: -2.04}
    autoComplete: 0
    storyText: Fuel you win will be deposited in the Tank. Use the big lever to move
      it into the Furnance and then burn it to go further.
  - cameraPos: {x: 0.9821617, y: 0, z: -1.5006341}
    cameraFocalPos: {x: -4.71, y: 0.99, z: -2.04}
    autoComplete: 0
    storyText: 'When the furnance has burnt all it''s fuel it produces soot which
      will clog up your wheel.

      So make sure to fill it up as much as you can
      before firing.'
  - cameraPos: {x: -1.6607786, y: 0, z: 2.1681523}
    cameraFocalPos: {x: -1.93, y: 2.08, z: 5}
    autoComplete: 0
    storyText: 'You will want to make sure to keep burning though.

      You''re
      not the only thing in these tunnels.'
  - cameraPos: {x: -1.6607786, y: 0, z: 2.1681523}
    cameraFocalPos: {x: -1.93, y: 2.08, z: 5}
    autoComplete: 0
    storyText: Watch how many spins you have left, run out and we both die.
  - cameraPos: {x: -1.9175583, y: 0, z: 3.9865608}
    cameraFocalPos: {x: -2.4910002, y: 1.3642299, z: 4.8}
    autoComplete: 0
    storyText: 'Trust me, it''s not pleasant.

      Now here is a little something
      to help you out.'
  cameraMoveDuration: 0.7
  storyTextDuration: 1
  runOneStory: []
  runTwoStory: []
  runThreeStory: []
