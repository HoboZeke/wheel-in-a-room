  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Menu
  menuScreen: {fileID: 5632983318638153589}
  menuCamera: {fileID: 7615019952494525528}
  gameViewCoverImage: {fileID: 0}
  fadeOutTime: 1
  cameraBasePos: {x: -16.5, y: 16.29, z: -16.69}
  cameraBaseRot: {x: 33.02854, y: 7.81095, z: 0.5027915}
  cameraTrackPoints:
  - {x: -8.9757595, y: 6.5800304, z: -2.570774}
  - {x: 163.4182, y: -110.70627, z: 174.70728}
  cameraRotationPoints:
  - {x: 30.522886, y: 37.643345, z: 0.0000039644647}
  - {x: 28.632368, y: 37.471428, z: -0.00018676335}
  cameraTrackTimes:
  - 1
  - 0.4
  optionsCameraRot: {x: 57.61773, y: 1.2119126, z: 0.010329511}
  optionsCameraPos: {x: -0.055961613, y: 1.3638, z: -38.479916}
  storyCameraRot: {x: 333.08173, y: 7.3228636, z: 0.47276357}
  cameraRotationDuration: 1
  storyText: {fileID: 7716233475598138452}
  storyStrings:
  - 'Once the sun had left us, the world chilled.

    But we were not left alone.'
  - 'For the moon looked up our world.

    Her pale face silently observing all
    we did.'
  - 'There is no one alive now who knows what she saw.

    What crimes we committed
    or great sin she witnessed.'
  - 'Whatever we did she turned her back on us.

    Her once bright guardian of
    night become something else.'
  - 'A dark forboding presence, silently hanging over us all.

    The winds came,
    the Winter deepened and her cold seeped into bone.'
  - 'We made efforts to reach out, the great and powerful built rockets.

    Taking
    the wealth of the world with them in a desperate plea. '
  - 'But soon even the vapours of the rockets faded and we were once more in darkness.

    Cold
    and alone except for the Moons condeming scorn. '
  - 'In desperation people bagan to call to old gods and ancient powers to save them
    from the Winter.

    Most ignored our pleas.'
  - But one answered.
  - 'A sulphourus tunnel opened into the depths of the world.

    Sinister and threatening
    yet warm, a bargain was made.'
  - 'If one of us makes it to the Denizen''s home deep in the earth.

    Then they
    will provide space for all to shelter from the empty sky.'
  - The catch, you must use the Denizen's own engine.
  - Will you make it before we all freeze?
  storyTimes:
  - 0.5
  - 0.5
  - 0.5
  - 0.5
  - 0.5
  - 0.5
  - 0.5
  - 0.5
  - 0.5
  - 0.5
  - 0.5
  - 0.5
  - 0.5
  storyStartDelay: 1
