    - target: {fileID: 1841587197788377690, guid: e58e5ceec4a1c8846af74bf4acff6e1b, type: 3}
      propertyPath: defaultControllerButton
      value: 
      objectReference: {fileID: 9191474409279216044}
    - target: {fileID: 1841587197788377690, guid: e58e5ceec4a1c8846af74bf4acff6e1b, type: 3}
      propertyPath: runThreeStory.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 1841587197788377690, guid: e58e5ceec4a1c8846af74bf4acff6e1b, type: 3}
      propertyPath: runOneStory.Array.data[0].storyText
      value: 'So your back?

        Trapped endlessly in the engine like me?'
      objectReference: {fileID: 0}
    - target: {fileID: 1841587197788377690, guid: e58e5ceec4a1c8846af74bf4acff6e1b, type: 3}
      propertyPath: runOneStory.Array.data[1].storyText
      value: Well nothing to it but to fuel the fires.
      objectReference: {fileID: 0}
    - target: {fileID: 1841587197788377690, guid: e58e5ceec4a1c8846af74bf4acff6e1b, type: 3}
      propertyPath: runTwoStory.Array.data[0].storyText
      value: 'You aren''t the first one to try to get to the end.

        But you
        are the first to do it alone.'
      objectReference: {fileID: 0}
    - target: {fileID: 1841587197788377690, guid: e58e5ceec4a1c8846af74bf4acff6e1b, type: 3}
      propertyPath: runTwoStory.Array.data[1].storyText
      value: That takes courage.
      objectReference: {fileID: 0}
    - target: {fileID: 1841587197788377690, guid: e58e5ceec4a1c8846af74bf4acff6e1b, type: 3}
      propertyPath: runTwoStory.Array.data[2].storyText
      value: Or Stupidity.
      objectReference: {fileID: 0}
    - target: {fileID: 1841587197788377690, guid: e58e5ceec4a1c8846af74bf4acff6e1b, type: 3}
      propertyPath: runOneStory.Array.data[0].cameraPos.x
      value: -1.9175583
      objectReference: {fileID: 0}
    - target: {fileID: 1841587197788377690, guid: e58e5ceec4a1c8846af74bf4acff6e1b, type: 3}
      propertyPath: runOneStory.Array.data[0].cameraPos.z
      value: 3.9865608
      objectReference: {fileID: 0}
    - target: {fileID: 1841587197788377690, guid: e58e5ceec4a1c8846af74bf4acff6e1b, type: 3}
      propertyPath: runOneStory.Array.data[1].cameraPos.x
      value: -1.9175583
      objectReference: {fileID: 0}
    - target: {fileID: 1841587197788377690, guid: e58e5ceec4a1c8846af74bf4acff6e1b, type: 3}
      propertyPath: runOneStory.Array.data[1].cameraPos.z
      value: 3.9865608
      objectReference: {fileID: 0}
    - target: {fileID: 1841587197788377690, guid: e58e5ceec4a1c8846af74bf4acff6e1b, type: 3}
      propertyPath: runThreeStory.Array.data[0].storyText
      value: 'The other groups never made it.

        Never left either in a way.'
      objectReference: {fileID: 0}
    - target: {fileID: 1841587197788377690, guid: e58e5ceec4a1c8846af74bf4acff6e1b, type: 3}
      propertyPath: runThreeStory.Array.data[1].storyText
      value: 'You might find some of the rubbish they left behind

        if you
        look around.'
      objectReference: {fileID: 0}
    - target: {fileID: 1841587197788377690, guid: e58e5ceec4a1c8846af74bf4acff6e1b, type: 3}
      propertyPath: runTwoStory.Array.data[0].cameraPos.x
